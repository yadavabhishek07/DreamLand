# Server Configuration
PORT=5000
NODE_ENV=production
SECRET=your_super_secret_session_key

# MongoDB Connection
# Replace with your MongoDB Atlas connection string
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dream_land?retryWrites=true&w=majority

# Cloudinary Storage (for listing photo uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 (Optional for Social Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email Configuration (Optional for OTP verification)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
